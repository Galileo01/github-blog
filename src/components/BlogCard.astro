---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const slug = post.id.replace(/\.md$/, '');
const badgeBudget = 4;
const tagBudget = badgeBudget - (data.draft ? 1 : 0);
const hasHiddenTags = data.tags.length > tagBudget;
const visibleTags = hasHiddenTags ? data.tags.slice(0, tagBudget - 1) : data.tags;
const hiddenTagCount = data.tags.length - visibleTags.length;
---

<article class="group h-full rounded-lg border border-border bg-card p-5 shadow-sm transition-all hover:shadow-md">
  <a href={`/blog/${slug}/`} class="flex h-full flex-col">
    <div class="mb-3 flex flex-wrap content-start gap-2 sm:min-h-14">
      {data.draft && (
        <span class="inline-flex max-w-[calc(50%-0.25rem)] items-center truncate rounded-full border border-destructive/40 bg-destructive/10 px-2.5 py-0.5 text-xs font-medium text-destructive">
          草稿
        </span>
      )}
      {visibleTags.map((tag: string) => (
        <span
          class="inline-flex max-w-[calc(50%-0.25rem)] items-center truncate rounded-full border bg-secondary/50 px-2.5 py-0.5 text-xs font-medium text-secondary-foreground"
          title={tag}
        >
          {tag}
        </span>
      ))}
      {hiddenTagCount > 0 && (
        <span
          class="inline-flex max-w-[calc(50%-0.25rem)] items-center rounded-full border bg-secondary/50 px-2.5 py-0.5 text-xs font-medium text-secondary-foreground"
          title={`另有 ${hiddenTagCount} 个标签`}
          aria-label={`另有 ${hiddenTagCount} 个标签`}
        >
          +{hiddenTagCount}
        </span>
      )}
    </div>
    <h3 class="line-clamp-2 text-lg leading-7 font-semibold tracking-tight transition-colors group-hover:text-primary sm:min-h-14">
      {data.title}
    </h3>
    <p class="mt-2 line-clamp-2 text-sm leading-5 text-muted-foreground sm:min-h-10">
      {data.description}
    </p>
    <time class="mt-auto block pt-3 text-xs text-muted-foreground">
      {new Date(data.date).toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </time>
  </a>
</article>
